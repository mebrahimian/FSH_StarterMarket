{
  "Billing": {
    "DefaultPlanKey": "free",
    "GracePeriodDays": 7
  },
  "OpenTelemetryOptions": {
    "Enabled": true,
    "Tracing": {
      "Enabled": true
    },
    "Metrics": {
      "Enabled": true,
      "MeterNames": [ "FSH.Modules.Identity", "FSH.Modules.Multitenancy", "FSH.Modules.Auditing" ]
    },
    "Exporter": {
      "Otlp": {
        "Enabled": false,
        "Endpoint": "http://localhost:4317",
        "Protocol": "grpc"
      }
    },
    "Jobs": { "Enabled": true },
    "Mediator": { "Enabled": true },
    "Http": {
      "Histograms": {
        "Enabled": true
      }
    },
    "Data": {
      "FilterEfStatements": true,
      "FilterRedisCommands": true
    }
  },
  "Serilog": {
    "Using": [
      "Serilog.Sinks.Console"
    ],
    "Enrich": [ "FromLogContext", "WithMachineName", "WithThreadId", "WithCorrelationId", "WithProcessId", "WithProcessName" ],
    "MinimumLevel": {
      "Default": "Debug"
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "restrictedToMinimumLevel": "Information"
        }
      }
    ]
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Hangfire": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "DatabaseOptions": {
    "Provider": "MSSQL",
    // "ConnectionString": "Data Source=185.211.56.254,1453;Initial Catalog=mebrahim_Bors;user id=mebrahim_Vam;Password=p2Ee7x16&;Integrated Security=false;Encrypt=True;TrustServerCertificate=True;",
    "MigrationsAssembly": "FSH.Starter.Migrations.MSSQL"
  },
  "OriginOptions": {
    "OriginUrl": "https://localhost:7030"
  },
  "CachingOptions": {
    "Redis": ""
  },
  "HangfireOptions": {
    "Username": "",
    "Password": "",
    "Route": "/jobs"
  },
  "PasswordPolicy": {
    "PasswordHistoryCount": 5,
    "PasswordExpiryDays": 90,
    "PasswordExpiryWarningDays": 14,
    "EnforcePasswordExpiry": true
  },
  "AllowedHosts": "*",
  "OpenApiOptions": {
    "Enabled": true,
    "Title": "FSH PlayGround API",
    "Version": "v1",
    "Description": "The FSH Starter Kit API for Modular/Multitenant Architecture.",
    "Contact": {
      "Name": "Mukesh Murugan",
      "Url": "https://codewithmukesh.com",
      "Email": "mukesh@codewithmukesh.com"
    },
    "License": {
      "Name": "MIT License",
      "Url": "https://opensource.org/licenses/MIT"
    }
  },
  "CorsOptions": {
    "AllowAll": false,
    "AllowedOrigins": [
      "http://localhost:5173",
      "http://localhost:5174"
    ],
    "AllowedHeaders": [ "content-type", "authorization" ],
    "AllowedMethods": [ "GET", "POST", "PUT", "DELETE" ]
  },
  "Seed": {
    "Demo": true,
    "DemoPassword": "Password123!",
    "DefaultAdminPassword": "123Pa$$word!"
  },
  "JwtOptions": {
    "Issuer": "fsh.local",
    "Audience": "fsh.clients",
    "SigningKey": "",
    "AccessTokenMinutes": 45,
    "RefreshTokenDays": 7
  },
  "SecurityHeadersOptions": {
    "Enabled": true,
    "ExcludedPaths": [ "/scalar", "/openapi" ],
    "AllowInlineStyles": true,
    "ScriptSources": [],
    "StyleSources": []
  },
  "MailOptions": {
    "UseSendGrid": false,
    "From": "mukesh@fullstackhero.net",
    "DisplayName": "Mukesh Murugan",
    "SMTP": {
      "Host": "smtp.ethereal.email",
      "Port": 587,
      "UserName": "",
      "Password": ""
    },
    "SendGrid": {
      "ApiKey": "",
      "From": "sendgrid@fullstackhero.net",
      "DisplayName": "FSH SendGrid"
    }
  },
  "RateLimitingOptions": {
    "Enabled": false,
    "Tenant": {
      "PermitLimit": 1000,
      "WindowSeconds": 60,
      "QueueLimit": 0
    },
    "User": {
      "PermitLimit": 200,
      "WindowSeconds": 60,
      "QueueLimit": 0
    },
    "Ip": {
      "PermitLimit": 300,
      "WindowSeconds": 60,
      "QueueLimit": 0
    },
    "Auth": {
      "PermitLimit": 10,
      "WindowSeconds": 60,
      "QueueLimit": 0
    }
  },
  "Storage": {
    "Provider": "local"
  },
  "QuotaOptions": {
    "Enabled": false,
    "Redis": "",
    "DefaultPlan": "free",
    "ExemptRootTenant": true,
    "Plans": {
      "free": {
        "ApiCalls": 10000,
        "StorageBytes": 1073741824,
        "Users": 5,
        "ActiveFeatureFlags": 10
      },
      "pro": {
        "ApiCalls": 1000000,
        "StorageBytes": 107374182400,
        "Users": 100,
        "ActiveFeatureFlags": 100
      }
    }
  },
  "Files": {
    "UploadUrlTtlMinutes": 15,
    "DownloadUrlTtlMinutes": 60,
    "OrphanRetentionMinutes": 60,
    "SoftDeleteRetentionDays": 30,
    "Categories": {
      "Image": {
        "AllowedExtensions": [ ".jpg", ".jpeg", ".png", ".webp", ".gif", ".ico" ],
        "MaxBytes": 10485760
      },
      "Document": {
        "AllowedExtensions": [ ".pdf", ".docx", ".xlsx", ".pptx", ".txt", ".csv" ],
        "MaxBytes": 26214400
      },
      "Archive": {
        "AllowedExtensions": [ ".zip" ],
        "MaxBytes": 52428800
      }
    }
  },
  "Auditing": {
    "Retention": {
      "Enabled": true,
      "ActivityRetentionDays": 1,
      "EntityChangeRetentionDays": 1,
      "SecurityRetentionDays": 365,
      "ExceptionRetentionDays": 180,
      "DeleteBatchSize": 5000,
      "Cron": "30 3 * * *"
    }
  },
  "Codal": {
    "BaseUrl": "https://www.codal.ir"
  },
  "MarketIntelligence": {
    "Codal": {
      "BackfillStartPage": 3560
    }
  }
}
