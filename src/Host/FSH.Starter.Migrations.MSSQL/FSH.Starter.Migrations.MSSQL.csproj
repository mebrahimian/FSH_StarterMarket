    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
	<ProjectReference Include="..\..\BuildingBlocks\Persistence\Persistence.csproj" />  
    <ProjectReference Include="..\..\Modules\Auditing\Modules.Auditing\Modules.Auditing.csproj" />
    <ProjectReference Include="..\..\Modules\Billing\Modules.Billing\Modules.Billing.csproj" />
    <ProjectReference Include="..\..\Modules\Catalog\Modules.Catalog\Modules.Catalog.csproj" />
    <ProjectReference Include="..\..\Modules\Chat\Modules.Chat\Modules.Chat.csproj" />
    <ProjectReference Include="..\..\Modules\Files\Modules.Files\Modules.Files.csproj" />
    <ProjectReference Include="..\..\Modules\Identity\Modules.Identity\Modules.Identity.csproj" />
    <ProjectReference Include="..\..\Modules\MarketIntelligence\Modules.MarketIntelligence\Modules.MarketIntelligence.csproj" />
    <ProjectReference Include="..\..\Modules\Multitenancy\Modules.Multitenancy\Modules.Multitenancy.csproj" />
    <ProjectReference Include="..\..\Modules\Notifications\Modules.Notifications\Modules.Notifications.csproj" />
    <ProjectReference Include="..\..\Modules\Tickets\Modules.Tickets\Modules.Tickets.csproj" />
    <ProjectReference Include="..\..\Modules\Webhooks\Modules.Webhooks\Modules.Webhooks.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Folder Include="Billing\" />
    <Folder Include="Catalog\" />
    <Folder Include="Chat\" />
    <Folder Include="Files\" />
    <Folder Include="Identity\" />
    <Folder Include="MultiTenancy\" />
    <Folder Include="Webhooks\" />
    <Folder Include="Tickets\" />
    <Folder Include="Notifications\" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Tools">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>
  <PropertyGroup>
		<RootNamespace>FSH.Starter.Migrations.MSSQL</RootNamespace>
		<AssemblyName>FSH.Starter.Migrations.MSSQL</AssemblyName>
		<TargetFramework>net10.0</TargetFramework>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>

		<!-- Suppress analyzer warnings for EF Core auto-generated migration files -->
		<NoWarn>$(NoWarn);CA1062;CA1861</NoWarn>
  </PropertyGroup>

</Project>
